table usage

	measure 'Cost' = SUM(usage[cost_usd])
		formatString: \$#,0.00

	measure 'Tokens' = SUM(usage[input_tokens]) + SUM(usage[output_tokens])
		formatString: #,0

	measure 'Input Tokens' = SUM(usage[input_tokens])
		formatString: #,0

	measure 'Output Tokens' = SUM(usage[output_tokens])
		formatString: #,0

	measure 'Cache Read Tokens' = SUM(usage[cache_read_tokens])
		formatString: #,0

	measure 'Calls' = SUM(usage[call_count])
		formatString: #,0

	measure 'Cost per Call' = DIVIDE([Cost], [Calls])
		formatString: \$#,0.0000

	measure 'Active Days' = DISTINCTCOUNT(usage[date])
		formatString: #,0

	measure 'Cost per Active Day' = DIVIDE([Cost], [Active Days])
		formatString: \$#,0.00

	column date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date

	column model_key
		dataType: string
		summarizeBy: none
		sourceColumn: model_key

	column project_key
		dataType: string
		summarizeBy: none
		sourceColumn: project_key

	column input_tokens
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: input_tokens

	column output_tokens
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: output_tokens

	column cache_read_tokens
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: cache_read_tokens

	column cache_creation_tokens
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: cache_creation_tokens

	column call_count
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: calls

	column cost_usd
		dataType: double
		formatString: \$#,0.00
		summarizeBy: sum
		sourceColumn: cost_usd

	partition usage = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ExportFolder & "\usage.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    NoBlank = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"date"}),
				    Typed = Table.TransformColumnTypes(NoBlank, {{"date", type date}, {"model_key", type text}, {"project_key", type text}, {"input_tokens", Int64.Type}, {"output_tokens", Int64.Type}, {"cache_read_tokens", Int64.Type}, {"cache_creation_tokens", Int64.Type}, {"calls", Int64.Type}, {"cost_usd", type number}}, "en-US")
				in
				    Typed
